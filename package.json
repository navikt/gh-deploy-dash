{
	"name": "gh-deploy-dash",
	"version": "0.0.1",
	"private": true,
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"codegen": "graphql-codegen-esm --config codegen.ts"
	},
	"devDependencies": {
		"@graphql-codegen/cli": "5.0.6",
		"@graphql-codegen/typescript": "4.1.6",
		"@graphql-codegen/typescript-document-nodes": "4.0.16",
		"@graphql-codegen/typescript-resolvers": "4.5.1",
		"@octokit/graphql-schema": "^15.26.0",
		"@sveltejs/adapter-auto": "^6.0.1",
		"@sveltejs/vite-plugin-svelte": "^5.0.3",
		"@types/eslint": "^9.6.1",
		"eslint": "^9.27.0",
		"eslint-config-prettier": "^10.1.5",
		"eslint-plugin-svelte": "^3.9.0",
		"prettier": "^3.5.3",
		"prettier-plugin-svelte": "^3.4.0",
		"svelte-adapter-bun": "^0.5.2",
		"svelte-check": "^4.2.1",
		"typescript": "^5.8.3",
		"typescript-eslint": "^8.32.1",
		"vite": "^6.3.5"
	},
	"type": "module",
	"dependencies": {
		"@nais/ds-svelte-community": "^1.0.1",
		"@nais/ds-svelte-community-preprocess-svelte": "^1.0.0",
		"@octokit/auth-oauth-app": "^9.0.1",
		"@octokit/oauth-app": "^8.0.1",
		"@sveltejs/kit": "^2.21.1",
		"@tanstack/svelte-query": "^5.77.1",
		"@types/js-cookie": "^3.0.6",
		"date-fns": "^4.1.0",
		"globals": "^16.2.0",
		"js-cookie": "^3.0.5",
		"octokit": "^5.0.2",
		"svelte": "^5.33.2"
	}
}
